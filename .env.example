# Supabase (필수) — Supabase 대시보드 > Project Settings > API
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...

# 카카오 로그인 (필수) — Kakao Developers > 내 애플리케이션 > 앱 키 > 네이티브 앱 키
# 없으면 빌드는 되지만 카카오 로그인이 동작하지 않습니다.
EXPO_PUBLIC_KAKAO_NATIVE_APP_KEY=

